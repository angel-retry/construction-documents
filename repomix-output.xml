					</div>
					{order && (
						<p>
							項次：{order.number}｜{order.title}｜
							{order.case_override === "normal"
								? "一般派工"
								: order.case_override === "independent"
									? "獨立派工"
									: "自動判斷"}
						</p>
					)}
					<button disabled={!order} type="submit">
						{pending ? "歸入中…" : `歸入 ${year} 年 ${month} 月`}
					</button>
				</fieldset>
				<p role="status">{state.message}</p>
			</form>
		</section>
	);
}
