"use client";
import {
	useActionState,
	useCallback,
	useEffect,
	useRef,
	useState,
} from "react";
import { addItem } from "./actions";
import { workDatesToDays } from "../../../../lib/legacy-work-dates";
import { itemAmount, monthQuantity } from "../../../../lib/quantity-math";
import {
	QuantitySaveQueue,
	type QuantityDraft,
	type QuantityPatch,
} from "../../../../lib/quantity-save-queue";
const money = (n: number) =>
	n.toLocaleString("zh-TW", {
		minimumFractionDigits: 2,
		maximumFractionDigits: 2,
	});
export default function QuantityBoard({
	sites,
	targets: initialTargets,
	daily,
	catalog,
	year,
	month,
	editable,
}: any) {
	const [amounts, setAmounts] = useState<Record<string, number>>({});
	const [saved, setSaved] = useState<Record<string, any>>({});
	const status = useRef<Record<string, boolean>>({});
	const onAmount = useCallback(
		(id: string, value: number) =>
			setAmounts((a) => (a[id] === value ? a : { ...a, [id]: value })),
		[],
	);
	const onStatus = useCallback((id: string, unsafe: boolean) => {
		status.current[id] = unsafe;
	}, []);
	const onSaved = useCallback(
		(id: string, draft: QuantityDraft, revision: number, removed: boolean) => {
			setSaved((s) => ({
				...s,
				[id]: {
					target_quantity: draft.target,
					note: draft.note,
					revision,
					removed,
				},
			}));
			if (removed)
				setAmounts((a) => {
					const next = { ...a };
					delete next[id];
					return next;
				});
		},
		[],
	);
	const targets = initialTargets
		.map((t: any) =>
			saved[t.id]?.revision >= t.revision ? { ...t, ...saved[t.id] } : t,
		)
		.filter((t: any) => !t.removed);
	const total = targets.reduce(
		(sum: number, t: any) =>
			sum +
			(amounts[t.id] ??
				itemAmount(
					Number(t.target_quantity),
					Number(t.work_order_items.contract_items.unit_price),
				)),
		0,
	);
	useEffect(() => {
		const unsafe = () => Object.values(status.current).some(Boolean);
		const unload = (e: BeforeUnloadEvent) => {
			if (unsafe()) e.preventDefault();
		};
		const click = (e: MouseEvent) => {
			const a = (e.target as Element).closest?.("a[href]");
			if (
				a &&
				unsafe() &&
				!window.confirm("仍有未儲存或儲存中的工項，確定離開？")
			) {
				e.preventDefault();
				e.stopPropagation();
			}
		};
		const submit = (e: SubmitEvent) => {
			if (
				(e.target as HTMLFormElement).querySelector("[name=year]") &&
				unsafe() &&
				!window.confirm("仍有未儲存或儲存中的工項，確定切換月份？")
			) {
				e.preventDefault();
				e.stopPropagation();
			}
		};
		window.addEventListener("beforeunload", unload);
		document.addEventListener("click", click, true);
		document.addEventListener("submit", submit, true);
		return () => {
			window.removeEventListener("beforeunload", unload);
			document.removeEventListener("click", click, true);
			document.removeEventListener("submit", submit, true);
		};
	}, []);
	return (
		<div className="quantity-board">
			<div className="quantity-headings">
				<h2>帳務總覽</h2>
				<h2>每日完成數量</h2>
			</div>
			<p className="old-caption">
				左側填本月數量與備註，備註框可拖曳右下角調整大小；右側分配每日完成數量。離開工項區塊會在背景自動儲存，可繼續輸入下一個工項；也可按「儲存工項」。顯示日期只篩選畫面，隱藏日期仍計入合計。
			</p>
			{!editable && <p>此標案或月份為唯讀。</p>}
			{sites.map((site: any) => (
				<SiteBlock
					key={site.id}
					{...{
						site,
						targets,
						daily,
						catalog,
						year,
						month,
						editable,
						onAmount,
						onSaved,
						onStatus,
					}}
				/>
			))}
			<h3>本月合計（含畫面試算）：{money(total)} 元</h3>
		</div>
	);
}
function SiteBlock({
	site,
	targets,
	daily,
	catalog,
	year,
	month,
	editable,
	onAmount,
	onSaved,
	onStatus,
}: any) {
	const [filter, setFilter] = useState<number[]>([]);
	const [search, setSearch] = useState("");
	const [code, setCode] = useState("");
	const [addState, addAction, adding] = useActionState(addItem, {
		message: "",
	});
	const count = new Date(Date.UTC(year + 1911, month, 0)).getUTCDate();
	const all = Array.from({ length: count }, (_, i) => i + 1);
	const workDays = workDatesToDays(site.work_dates, year + 1911, month);
	const workDaysSet = new Set(workDays || []);
	const visible = filter.length ? filter : workDays || all;
	const filterSummary =
		filter.length > 0
			? `自訂篩選中（已選 ${filter.length} 天，點擊可調整）`
			: workDays && workDays.length > 0
				? `依施工路段連動（共 ${workDays.length} 天）`
				: "未選擇時依原設定顯示，可複選日期";
	const rows = targets
		.filter(
			(t: any) =>
				t.work_order_items.work_order_site_id === site.work_order_site_id,
		)
		.sort(
			(a: any, b: any) =>
				a.work_order_items.contract_items.seq -
				b.work_order_items.contract_items.seq,
		);
	const used = new Set(
		rows.map((t: any) => t.work_order_items.contract_items.code),
	);
	const available = catalog.filter(
		(c: any) => !used.has(c.code) && `${c.code} ${c.name}`.includes(search),
	);
	const subtotal = rows.reduce(
		(sum: number, t: any) =>
			sum +
			itemAmount(
				Number(t.target_quantity),
				Number(t.work_order_items.contract_items.unit_price),
			),
		0,
	);
	return (
		<details open className="quantity-site">
			<summary>
				{site.item_number}　{site.name}　{site.work_dates}
			</summary>
			<div className="quantity-site-body">
				<div className="quantity-pair quantity-tools">
					<form action={addAction}>
						<input type="hidden" name="site" value={site.id} />
						<fieldset
							disabled={!editable || adding}
							style={{ border: 0, padding: 0 }}
						>
							<label className="old-field">
								搜尋工項
								<input
									value={search}
									onChange={(e) => {
										setSearch(e.target.value);
										setCode("");
									}}
									placeholder="工項代碼或名稱"
								/>
							</label>
							<div className="quantity-add">
								<label className="old-field">
									加入工項（可搜尋）
									<select
										name="code"
										required
										value={code}
										onChange={(e) => setCode(e.target.value)}
									>
										<option value="">請選擇工項</option>
										{available.map((c: any) => (
											<option key={c.code} value={c.code}>
												{c.code}｜{c.name}（{c.unit}）
											</option>
										))}
									</select>
								</label>
								<button className="old-primary" disabled={!code}>
									{adding ? "加入中…" : "加入"}
								</button>
							</div>
						</fieldset>
						<p role="status">{addState.message}</p>
					</form>
					<div>
						<span className="quantity-filter-label">顯示日期</span>
						<details className="day-filter">
							<summary>{filterSummary}</summary>
							<div className="quantity-days">
								{all.map((day) => {
									const isWorkDay = workDaysSet.has(day);
									return (
										<label
											key={day}
											style={
												isWorkDay
													? { fontWeight: 600, color: "var(--color-primary, #0969da)" }
													: undefined
											}
										>
											<input
												type="checkbox"
												checked={filter.includes(day)}
												onChange={(e) =>
													setFilter((v) =>
														e.target.checked
															? [...v, day].sort((a, b) => a - b)
															: v.filter((d) => d !== day),
													)
												}
											/>
											{month}/{day}
											{isWorkDay && (
												<span
													style={{
														fontSize: "0.75em",
														marginLeft: 2,
														opacity: 0.85,
													}}
												>
													[施工日]
												</span>
											)}
										</label>
									);
								})}
							</div>
							<div style={{ display: "flex", gap: "8px", marginTop: "8px" }}>
								<button
									type="button"
									onClick={() => setFilter([])}
									disabled={filter.length === 0}
								>
									依施工日期顯示
								</button>
								{workDays && workDays.length > 0 && (
									<button
										type="button"
										onClick={() => setFilter([...workDays])}
									>
										選取所有施工日
									</button>
								)}
							</div>
						</details>
						<p className="old-caption">
							{workDays?.length === 1
								? `單一施工日 ${month}/${workDays[0]}：儲存工項時，本月數量自動同步到當天。`
								: workDays && workDays.length > 0
									? `已依路段施工日期（${site.work_dates}）自動連動顯示。`
									: "未選擇時依施工日期顯示；未填施工日期則顯示整月。"}
						</p>
					</div>
				</div>
				<div className="quantity-pair quantity-column-head">
					<div className="quantity-account">
						<span />
						<span>工項代碼</span>
						<span>工作項目</span>
						<span>
							本月數量
							<br />
							（可編輯）
						</span>
						<span>單價</span>
						<span>本月金額</span>
						<span>備註</span>
					</div>
					<span>每日完成數量（各工項與左側同列，可橫向捲動日期）</span>
				</div>
				{!rows.length && <p>尚未加入工項。</p>}
				{rows.map((t: any) => (
					<ItemRow
						key={`${t.id}:${site.revision}`}
						target={t}
						site={site}
						daily={daily.filter(
							(d: any) => d.work_order_item_id === t.work_order_item_id,
						)}
						{...{ year, month, visible, editable, onAmount, onSaved, onStatus }}
						singleDay={workDays?.length === 1 ? workDays[0] : null}
					/>
				))}
				<p>已儲存小計：{money(subtotal)} 元</p>
			</div>
		</details>
	);
}
function ItemRow({
	target,
	site,
	daily,
	year,
	month,
	visible,
	editable,
	singleDay,
	onAmount,
	onSaved,
	onStatus,
}: any) {
	const item = target.work_order_items.contract_items;
	const [, render] = useState(0);
	const form = useRef<HTMLFormElement>(null);
	const callbacks = useRef({ onSaved, onStatus });
	callbacks.current = { onSaved, onStatus };
	const [queue] = useState(
		() =>
			new QuantitySaveQueue(
				{
					target: String(target.target_quantity),
					note: target.note,
					days: Object.fromEntries(
						daily.map((d: any) => [d.work_date, String(d.quantity)]),
					),
				},
				target.revision,
				async (patch: QuantityPatch, revision: number, remove: boolean) => {
					const data = new FormData();
					data.set("site", site.id);
					data.set("id", target.id);
					data.set("revision", String(revision));
					data.set("site_revision", String(site.revision));
					if (patch.target !== undefined) data.set("target", patch.target);
					if (patch.note !== undefined) data.set("note", patch.note);
					for (const [day, qty] of Object.entries(patch.days))
						data.set(`day:${day}`, qty);
					if (remove) data.set("operation", "remove");
					const response = await fetch(
						`/projects/${site.project_id}/quantities/save`,
						{ method: "POST", body: data },
					);
					if (!response.ok) throw Error("save failed");
					return await response.json();
				},
				() => {
					render((n) => n + 1);
					callbacks.current.onStatus(
						target.id,
						queue.dirty || queue.busy || queue.failed,
					);
				},
				(draft, revision, removed) =>
					callbacks.current.onSaved(target.id, draft, revision, removed),
			),
	);
	const { target: qty, note, days: values } = queue.draft;
	const edit = (patch: Partial<QuantityDraft>) =>
		queue.edit({ ...queue.draft, ...patch });
	const date = (day: number) =>
		`${year + 1911}-${String(month).padStart(2, "0")}-${String(day).padStart(2, "0")}`;
	const amount = itemAmount(Number(qty) || 0, Number(item.unit_price));
	const allocated = singleDay ? Number(qty) || 0 : monthQuantity(values);
	const remaining = (Number(qty) || 0) - allocated;
	useEffect(() => {
		onAmount(target.id, amount);
	}, [amount, target.id, onAmount]);
	useEffect(
		() => () => callbacks.current.onStatus(target.id, false),
		[target.id],
	);
	const syncNeeded =
		singleDay &&
		!queue.hasSaved &&
		(Number(values[date(singleDay)] || 0) !== Number(qty) ||
			Object.entries(values).some(
				([d, q]) => d !== date(singleDay) && Number(q) !== 0,
			));
	return (
		<form
			ref={form}
			method="post"
			className="quantity-item"
			onSubmit={(e) => {
				e.preventDefault();
				const remove =
					(e.nativeEvent as SubmitEvent).submitter?.getAttribute("value") ===
					"remove";
				void queue.submit(remove, !!syncNeeded);
			}}
			onBlur={(e) => {
				if (
					(queue.dirty || queue.busy) &&
					!e.currentTarget.contains(e.relatedTarget as Node) &&
					form.current?.checkValidity()
				)
					void queue.submit();
			}}
		>
			<fieldset
				disabled={!editable || queue.removing}
				style={{ border: 0, padding: 0 }}
			>
				<div className="quantity-pair">
					<div className="quantity-account">
						<button
							type="submit"
							name="operation"
							value="remove"
							disabled={queue.busy}
							className="quantity-remove"
							aria-label={`移除工項 ${item.code}（可恢復）`}
							title="移除工項（可恢復）"
						>
							×
						</button>
						<span>{item.code}</span>
						<span>
							{item.name}（{item.unit}）
						</span>
						<label>
							<span className="quantity-mobile-label">本月數量</span>
							<input
								aria-label={`${item.code} 本月數量`}
								type="number"
								name="target"
								min="0"
								max="999999999999.9999"
								step="0.0001"
								value={qty}
								onChange={(e) => edit({ target: e.target.value })}
							/>
						</label>
						<span>
							<span className="quantity-mobile-label">單價</span>
							{money(Number(item.unit_price))}
						</span>
						<span>
							<span className="quantity-mobile-label">本月金額</span>
							{money(amount)}
						</span>
						<label>
							<span className="quantity-mobile-label">備註</span>
							<textarea
								className="quantity-note"
								aria-label={`${item.code} 備註`}
								name="note"
								rows={3}
								title="拖曳右下角可調整備註框大小"
								placeholder="選填，可拖曳右下角放大"
								maxLength={2000}
								value={note}
								onChange={(e) => edit({ note: e.target.value })}
							/>
						</label>
					</div>
					<div>
						<div className="old-table-scroll">
							<table>
								<thead>
									<tr>
										{visible.map((d: number) => (
											<th key={d}>{d}日</th>
										))}
									</tr>
								</thead>
								<tbody>
									<tr>
										{visible.map((d: number) => (
											<td key={d}>
												<input
													aria-label={`${item.code} ${d}日數量`}
													className="quantity-day-input"
													type="number"
													min="0"
													max="999999999999.9999"
													step="0.0001"
													disabled={!!singleDay}
													value={
														singleDay
															? d === singleDay
																? qty
																: "0"
															: values[date(d)] || "0"
													}
													onChange={(e) =>
														edit({
															days: { ...values, [date(d)]: e.target.value },
														})
													}
												/>
											</td>
										))}
									</tr>
								</tbody>
							</table>
						</div>
						<p>
							每日合計：{allocated.toFixed(4)}｜
							{remaining < 0
								? `超出本月數量 ${(-remaining).toFixed(4)}`
								: `尚可分配 ${remaining.toFixed(4)}`}
						</p>
					</div>
				</div>
				{syncNeeded && <p>單日數量尚待同步，請按「儲存工項」。</p>}
				<button className="quantity-save" type="submit">
					{queue.failed ? "重試儲存" : "儲存工項"}
				</button>
			</fieldset>
			<p role="status">
				{queue.busy
					? "儲存中…"
					: queue.failed
						? `儲存失敗：${queue.message}`
						: queue.message}
				{queue.dirty ? " 有尚未儲存的變更。" : ""}
			</p>
		</form>
	);
}
</file>

<file path="web/app/projects/[id]/quantities/page.tsx">
import Link from "next/link";
import { notFound } from "next/navigation";
import catalogs from "../../../../lib/legacy-catalog.json";
import { uuidPattern } from "../../../../lib/project-validation";
import { monthMinimum, parsePeriod } from "../../../../lib/reporting-period";
import { requireUser } from "../../../../lib/supabase/session";
import PeriodMemory from "../sites/period-memory";
import QuantityBoard from "./board";
export const dynamic = "force-dynamic";
export default async function QuantitiesPage({
  params,
  searchParams,
}: {
  params: Promise<{ id: string }>;
  searchParams: Promise<{ year?: string; month?: string }>;
}) {
  const { client, user } = await requireUser();
  const { id } = await params;
  if (!uuidPattern.test(id)) notFound();
  const { data: p, error } = await client
    .from("projects")
    .select("id,org_id,code,name,kind,status")
    .eq("id", id)
    .maybeSingle();
  if (error) return <main>無法讀取標案。</main>;
  if (!p) notFound();
  const query = await searchParams;
  const period = parsePeriod(query.year, query.month, p.kind);
  const suffix = period ? `?year=${period.rocYear}&month=${period.month}` : "";
  const [org, member, periods] = await Promise.all([
    client
      .from("organization_members")
      .select("role,status")
      .eq("org_id", p.org_id)
      .eq("user_id", user.id)
      .maybeSingle(),
    client
      .from("project_members")
      .select("role,status")
      .eq("project_id", id)
      .eq("user_id", user.id)
      .maybeSingle(),
    client
      .from("reporting_periods")
      .select("id,period_start,status")
      .eq("project_id", id)
      .order("period_start", { ascending: false }),
  ]);
  const selected = periods.data?.find((r) => r.period_start === period?.start);
  const editable =
    p.status === "active" &&
    selected?.status === "open" &&
    org.data?.status === "active" &&
    (["owner", "admin"].includes(org.data.role) ||
      (member.data?.status === "active" &&
        ["manager", "office"].includes(member.data.role)));
  let sites: any[] = [],
    targets: any[] = [],
    daily: any[] = [],
    loadError = false;
  if (selected) {
    // Supabase caps individual reads; page through each period's records.
    const read = async (
      table: string,
      columns: string,
      filter: (q: any) => any,
    ) => {
      const rows: any[] = [];
      for (let offset = 0; ; offset += 500) {
        const { data, error } = await filter(
          client.from(table).select(columns).eq("project_id", id),
        )
          .order("id")
          .range(offset, offset + 499);
        if (error) {
          loadError = true;
          return [];
        }
        rows.push(...data);
        if (data.length < 500) return rows;
      }
    };
    [sites, targets, daily] = await Promise.all([
      read("monthly_sites", "*", (q) => q.eq("period_id", selected.id)),
      read(
        "item_period_targets",
        "*,work_order_items!inner(work_order_site_id,contract_items(*))",
        (q) => q.eq("period_id", selected.id).eq("removed", false),
      ),
      read(
        "daily_quantities",
        "id,work_order_item_id,work_date,quantity,status",
        (q) =>
          q
            .gte("work_date", period!.start)
            .lte("work_date", period!.end)
            .neq("status", "void"),
      ),
    ]);
    sites.sort((a, b) => a.sort_order - b.sort_order);
  }
  return (
    <main style={{ maxWidth: 1600, margin: "auto", padding: "32px 24px" }}>
      <PeriodMemory
        user={user.id}
        project={id}
        kind={p.kind}
        year={period?.rocYear}
        month={period?.month}
        restore={query.year === undefined && query.month === undefined}
        page="quantities"
      />
      <Link href="/projects">← 標案列表</Link>
      <h1 className="system-title">
        {p.kind === "park" ? "公園" : "雨水"}工程施工文件系統
      </h1>
      <p>
        {p.code}｜{p.name}
      </p>
      <div className="old-tabs">
        <Link href={`/projects/${id}`}>基本設定</Link>
        <Link href={`/projects/${id}/sites${suffix}`}>施工路段</Link>
        <button aria-current="page">每日數量與帳務總覽</button>
        <Link href={`/projects/${id}/prior${suffix}`}>前期累計</Link>
        <Link href={`/projects/${id}/export`}>匯出 Excel</Link>
      </div>
      <form method="get" key={period?.start || "unselected"}>
        <div className="old-grid two">
          <label className="old-field">
            民國年
            <input
              name="year"
              type="number"
              min="10"
              max="999"
              required
              defaultValue={period?.rocYear || 115}
            />
          </label>
          <label className="old-field">
            月份
            <select
              name="month"
              defaultValue={period?.month || monthMinimum(p.kind)}
            >
              {Array.from(
                { length: 13 - monthMinimum(p.kind) },
                (_, i) => i + monthMinimum(p.kind),
              ).map((m) => (
                <option key={m} value={m}>
                  {m} 月
                </option>
              ))}
            </select>
          </label>
        </div>
        <button>切換月份</button>
      </form>
      <h2>
        每日數量與帳務總覽
        {period ? `｜${period.rocYear}年${period.month}月` : ""}
      </h2>
      {periods.error || loadError ? (
        <p role="alert">
          無法讀取數量資料。若雲端尚未啟用，請先完成設定再使用。
        </p>
      ) : !period ? (
        <p>請先選擇民國年及月份。</p>
      ) : !sites.length ? (
        <p>
          本月份尚無施工路段，請先到
          <Link href={`/projects/${id}/sites${suffix}`}>施工路段</Link>
          新增或歸入派工單。
        </p>
      ) : (
        <QuantityBoard
          key={period.start}
          sites={sites}
          targets={targets}
          daily={daily}
          catalog={JSON.parse(catalogs[p.kind as keyof typeof catalogs])}
          year={period.rocYear}
          month={period.month}
          editable={!!editable}
        />
      )}
      <p className="old-caption">
        本月金額沿用原版內部試算方式；前期累計請至專屬分頁；Excel
        輸出請至匯出分頁，此頁不代表正式估驗或結算金額。
      </p>
    </main>
  );
}
</file>

