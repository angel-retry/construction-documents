<file path="web/app/projects/[id]/export/download/route.ts">
import { requireUser } from "../../../../../lib/supabase/session";
import { uuidPattern } from "../../../../../lib/project-validation";
import { parsePeriod } from "../../../../../lib/reporting-period";
import { exportSnapshot } from "../../../../../lib/export-data";
import { legacyProject } from "../../../../../lib/export-snapshot";
import { excelWorker } from "../../../../../lib/excel-worker";
export const runtime = "nodejs";
export const dynamic = "force-dynamic";
export async function POST(
	request: Request,
	{ params }: { params: Promise<{ id: string }> },
) {
	// Next's internal URL can use localhost while the browser uses 127.0.0.1.
	const origin = request.headers.get("origin");
	let sameOrigin = false;
	try {
		const parsed = new URL(origin ?? "");
		sameOrigin =
			["http:", "https:"].includes(parsed.protocol) &&
			parsed.host === request.headers.get("host") &&
			request.headers.get("sec-fetch-site") !== "cross-site";
	} catch {}
	if (!sameOrigin)
		return Response.json({ message: "請從本站匯出頁操作。" }, { status: 403 });
	const { client } = await requireUser();
	const { id } = await params;
	if (!uuidPattern.test(id)) return new Response("Not found", { status: 404 });
	try {
		const form = await request.formData();
		const { data: p } = await client
			.from("projects")
			.select("kind")
			.eq("id", id)
			.maybeSingle();
		if (!p) return new Response("Not found", { status: 404 });
		const period = parsePeriod(form.get("year"), form.get("month"), p.kind);
		if (!period) throw Error("請選擇有效月份。");
		const first = await exportSnapshot(client, id, period.start, period.end);
		if (first.hash !== form.get("snapshot"))
			return Response.json(
				{ message: "資料已更新，請重新整理匯出頁，核對後再產生。" },
				{ status: 409 },
			);
		const second = await exportSnapshot(client, id, period.start, period.end);
		if (first.hash !== second.hash)
			return Response.json(
				{ message: "有人正在修改本月份資料，請稍後重新整理再匯出。" },
				{ status: 409 },
			);
		const bytes = await excelWorker(legacyProject(second.snapshot));
		const name = `${p.kind === "park" ? "公園" : "雨水"}_${period.rocYear}年${period.month}月施工文件.zip`;
		return new Response(new Uint8Array(bytes), {
			headers: {
				"Content-Type": "application/zip",
				"Content-Disposition": `attachment; filename*=UTF-8''${encodeURIComponent(name)}`,
				"Cache-Control": "private, no-store",
				"X-Content-Type-Options": "nosniff",
			},
		});
	} catch (e) {
		return Response.json(
			{ message: e instanceof Error ? e.message : "匯出失敗，請稍後重試。" },
			{ status: 400 },
		);
	}
}
</file>

<file path="web/app/projects/[id]/export/form.tsx">
"use client";
import { useEffect, useState } from "react";
export default function ExportForm({
	project,
	period,
	year,
	month,
	hash,
	ready,
}: {
	project: string;
	period: string;
	year: number;
	month: number;
	hash: string;
	ready: boolean;
}) {
	const [busy, setBusy] = useState(false),
		[message, setMessage] = useState(""),
		[priorDirty, setPriorDirty] = useState(false);
	useEffect(() => {
		try {
			setPriorDirty(sessionStorage.getItem(`prior-dirty:${period}`) === "true");
		} catch {}
	}, [period]);
	return (
		<form
			onSubmit={async (e) => {
				e.preventDefault();
				if (busy || !ready || priorDirty) return;
				try {
					if (sessionStorage.getItem(`prior-dirty:${period}`) === "true") {
						setPriorDirty(true);
						return;
					}
				} catch {}
				setBusy(true);
				setMessage("正在產生施工日誌及結算／竣工單…");
				try {
					const body = new FormData();
					body.set("year", String(year));
					body.set("month", String(month));
					body.set("snapshot", hash);
					const response = await fetch(`/projects/${project}/export/download`, {
						method: "POST",
						body,
					});
					if (
						!response.ok ||
						!response.headers.get("content-type")?.includes("application/zip")
					) {
						const error = await response
							.json()
							.catch(() => ({
								message: "登入已逾時或下載失敗，請重新登入後重試。",
							}));
						throw Error(error.message);
					}
					const url = URL.createObjectURL(await response.blob());
					const a = document.createElement("a");
					a.href = url;
					a.download = decodeURIComponent(
						response.headers.get("content-disposition")?.split("UTF-8''")[1] ||
							"施工文件.zip",
					);
					a.click();
					setTimeout(() => URL.revokeObjectURL(url), 60000);
					setMessage("文件已產生並開始下載 ZIP，解壓縮後可開啟各份 Excel。");
				} catch (error) {
					setMessage(error instanceof Error ? error.message : "下載失敗。");
				} finally {
					setBusy(false);
				}
			}}
		>
			{priorDirty && (
				<p role="alert">
					前期累計仍有未儲存貼上內容。請先回前期累計套用並儲存，或清空不採用的貼上內容。
				</p>
			)}
			<button disabled={busy || !ready || priorDirty}>
				{busy ? "產生中…" : "產生並下載 Excel ZIP"}
			</button>
			<p role="status">{message}</p>
		</form>
	);
}
</file>

