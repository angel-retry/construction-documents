      row.innerHTML = rowHtml;
      tbody.appendChild(row);
    });

    document.getElementById("siteSubtotal").innerText = `$${siteSubtotal.toLocaleString("zh-TW", { minimumFractionDigits: 2 })}`;
  }

  function renderGrandTotal() {
    let grand = 0;
    sites.forEach(site => {
      site.items.forEach(item => {
        grand += Math.floor(item.total * item.price * 100) / 100;
      });
    });
    document.getElementById("grandTotal").innerText = `$${grand.toLocaleString("zh-TW", { minimumFractionDigits: 2 })}`;
  }

  function switchSite(idx) {
    currentSiteIdx = idx;
    renderSidebar();
    renderMainTable();
  }

  function changeTotal(itemIdx, val) {
    sites[currentSiteIdx].items[itemIdx].total = Number(val) || 0;
    renderSidebar();
    renderMainTable();
  }

  function changeDaily(itemIdx, day, val) {
    sites[currentSiteIdx].items[itemIdx].days[day] = Number(val) || 0;
    renderMainTable();
  }

  function changeNote(itemIdx, val) {
    sites[currentSiteIdx].items[itemIdx].note = val;
  }

  function autoDistribute(itemIdx) {
    const site = sites[currentSiteIdx];
    const item = site.items[itemIdx];
    const days = site.workDays;
    if (!days.length) return;

    const base = Math.floor((item.total / days.length) * 10) / 10;
    const remainder = Math.round((item.total - (base * days.length)) * 10) / 10;

    days.forEach((d, i) => {
      item.days[d] = i === days.length - 1 ? (base + remainder) : base;
    });

    renderMainTable();
  }

  // 初始加載
  renderSidebar();
  renderMainTable();
</script>

</body>
</html>
</file>

