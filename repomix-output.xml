def _write_analysis_footer_park(

    ws,

    tpl_ws,

    start_row: int,

    project: Project,

    unit: "_ParkUnit",

    site_header_rows: list[int],

    j_data_rows: list[int],

    month: int,

    roc_year: int,

    month_days: int,

    subtotal_l_cells: list[str] | None = None,

) -> int:

    start_day, end_day = unit.day_range

    end_day = min(end_day, month_days)

